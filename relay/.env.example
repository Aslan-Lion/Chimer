# app.timer online relay - example environment.
#
# Copy this file to `relay.env` and replace every <placeholder>. Nothing here is
# a real credential, certificate or domain, and the relay will refuse to start
# with these values as shipped, because the certificate paths do not exist.
#
# See relay/README.md for how to generate each value.

# --- Listener -------------------------------------------------------------

# Address and port the relay binds to.
# Default: 0.0.0.0:8443 when TLS is configured, 127.0.0.1:8788 in insecure mode.
RELAY_BIND=0.0.0.0:8443

# --- TLS ------------------------------------------------------------------
#
# Both must be set together, or both left unset. The certificate must be a PEM
# chain (leaf first); the key an unencrypted PEM private key that matches it.
# There is no switch anywhere that weakens certificate verification.

RELAY_TLS_CERT=/etc/relay/tls/fullchain.pem
RELAY_TLS_KEY=/etc/relay/tls/privkey.pem

# --- Hosts ----------------------------------------------------------------
#
# Comma-separated <host-id>:<credential> pairs. The host id is the identifier
# the Windows application generates (for example h-abc123...); the credential is
# the shared secret the host presents when it registers. Each credential must be
# at least 16 characters - generate one with `openssl rand -base64 32`.
#
# There is deliberately no default: an empty list means no host may register.

RELAY_HOSTS=h-example01:<replace-with-a-long-random-secret>

# --- Web root -------------------------------------------------------------
#
# Directory holding the built remote application (index.html plus assets). The
# container image builds this for you; on a bare VM point it at your build
# output.

RELAY_WEB_ROOT=dist

# --- Origins --------------------------------------------------------------
#
# The origin the remote application is served from. Setting this pins the
# same-origin check to exactly this value; leaving it empty derives the origin
# from the request. Extra origins (comma-separated) are additionally allowed.

# RELAY_PUBLIC_ORIGIN=https://<your-relay-host>
# RELAY_ALLOWED_ORIGINS=https://<another-host>

# --- Limits ---------------------------------------------------------------
#
# Defaults are shown. RELAY_MAX_FRAME_BYTES has a hard ceiling of 65536, and
# RELAY_MAX_PAYLOAD_BYTES may not exceed RELAY_MAX_FRAME_BYTES.

RELAY_MAX_HOSTS=64
RELAY_MAX_DEVICES_PER_HOST=32
RELAY_MAX_CONNECTIONS=512
RELAY_MAX_FRAME_BYTES=16384
RELAY_MAX_PAYLOAD_BYTES=8192
RELAY_DATA_FRAMES_PER_SEC=40
RELAY_CONN_PER_MIN=30

# --- Logging --------------------------------------------------------------

# error | warn | info | debug
RELAY_LOG=info

# --- Insecure development mode --------------------------------------------
#
# NEVER enable this on a network-reachable bind. With RELAY_ALLOW_INSECURE=1 the
# relay serves plaintext, but ONLY on a loopback address; any other bind is a
# hard start-up error. Leave unset (or 0) in production.

RELAY_ALLOW_INSECURE=0
